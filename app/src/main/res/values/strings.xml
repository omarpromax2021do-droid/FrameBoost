    <!-- Onboarding -->
    <string name="onboarding_step_format">Step %1$d of %2$d</string>
    <string name="onboarding_s1_title">Double Smoothness, Zero Blur</string>
    <string name="onboarding_s1_desc">Framewise uses OpenGL ES 3.1+ GPU shaders to generate intermediate motion-compensated frames (30→60 or 60→120 FPS) and applies Contrast Adaptive Sharpening (CAS) so fast gameplay stays razor-sharp.</string>
    <string name="onboarding_s1_card1_title">Optical Flow Interpolation</string>
    <string name="onboarding_s1_card1_desc">Synthesizes smooth intermediate frames directly on the GPU with occlusion and edge guards to prevent ghosting.</string>
    <string name="onboarding_s1_card2_title">AMD CAS Anti-Blur Pass</string>
    <string name="onboarding_s1_card2_desc">Fused 5-tap Contrast Adaptive Sharpening removes dynamic-resolution softness without adding extra render passes.</string>

    <string name="onboarding_s2_title">Honest Technical Expectations</string>
    <string name="onboarding_s2_desc">Framewise never fakes metrics. Here is what real hardware interpolation requires:</string>
    <string name="onboarding_s2_point1">• Console Mode (30→60 FPS) works best when the base game holds a steady 25–30+ FPS.</string>
    <string name="onboarding_s2_point2">• Competitive Mode (60→120 FPS) requires a 90/120Hz screen and a steady 45–60+ FPS base rate.</string>
    <string name="onboarding_s2_point3">• Frame generation holds 1 previous frame in GPU memory, adding ~1 frame of pipeline latency.</string>
    <string name="onboarding_s2_point4">• Android 14+ Single-App Capture is recommended so Framewise captures only the game window and never loops over its own overlay.</string>

    <string name="onboarding_s3_title">Guided Permission Setup</string>
    <string name="onboarding_s3_desc">Grant the core system permissions below. Screen Capture is requested securely each time you start a session.</string>
    <string name="perm_capture_title">Single-App Screen Capture</string>
    <string name="perm_capture_desc">Requested via Android MediaProjection when starting frame generation. On Android 14+, pick only your target game window.</string>
    <string name="perm_capture_badge">On Launch</string>
    <string name="perm_accessibility_title">Touch-Passthrough Overlay &amp; Auto-Pilot</string>
    <string name="perm_accessibility_desc">Accessibility overlay keeps touches 100% responsive on Android 12–14+ and detects foreground games like COD Mobile &amp; RDR1.</string>
    <string name="perm_notifications_title">Session Notifications</string>
    <string name="perm_notifications_desc">Required to run the persistent Foreground Capture &amp; GPU Pacing notification cleanly.</string>
    <string name="perm_battery_title">Unrestricted Battery Usage</string>
    <string name="perm_battery_desc">Prevents Android Doze from throttling the GPU render thread during long gaming sessions.</string>
    <string name="perm_write_settings_title">System Refresh Rate Lock (60Hz ↔ 120Hz/144Hz+)</string>
    <string name="perm_write_settings_desc">Allows Framewise to lock peak display refresh rate in Android system settings during gameplay and restore it on exit.</string>

    <string name="onboarding_s4_title">3-Second GPU Calibration</string>
    <string name="onboarding_s4_desc">Run a real 3.0-second offscreen OpenGL ES shader benchmark on your GPU to measure pass timing and configure optimal presets automatically.</string>
